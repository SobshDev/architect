{
  "name": "@sobshdev/architect",
  "version": "0.1.0",
  "description": "Design memory and structural checks for coding agents.",
  "license": "MIT",
  "author": "Gabriel Brument <gabriel@mentem.app>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SobshDev/architect.git"
  },
  "type": "module",
  "packageManager": "bun@1.3.14",
  "engines": {
    "bun": ">=1.3.14"
  },
  "bin": {
    "architect": "src/cli/main.ts"
  },
  "files": [
    "src",
    "!src/**/*.test.ts",
    "skills",
    "knowledge/cards",
    "packs",
    "action.yml",
    "LICENSE",
    "NOTICE",
    "README.md"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "bun test",
    "check": "bun run typecheck && bun test && bun src/cli/main.ts check && bun src/cli/main.ts decision lint",
    "corpus:fetch": "bun scripts/corpus-fetch.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "2.1.0",
    "picomatch": "4.0.7",
    "typescript": "6.0.3",
    "web-tree-sitter": "0.27.0",
    "yaml": "2.9.1",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "2.1.0",
    "@types/bun": "1.3.14",
    "@types/picomatch": "4.0.3"
  }
}
